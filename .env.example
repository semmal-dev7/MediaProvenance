# Environment Configuration
# Copy to .env.local and fill in values. NEVER commit .env.local.

# ── Application ───────────────────────────────────────────────────────────────
PROVENANCELAB_ENV=development
PROVENANCELAB_DEBUG=true
PROVENANCELAB_SECRET_KEY=CHANGE_ME_IN_PRODUCTION

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///d:/MediaProvenance/experiments/provenancelab.db

# ── Experiment storage ────────────────────────────────────────────────────────
EXPERIMENT_ROOT=d:/MediaProvenance/experiments
RESULTS_DIR=d:/MediaProvenance/experiments/results
CALIBRATION_DIR=d:/MediaProvenance/experiments/calibration

# ── Watermark carriers ────────────────────────────────────────────────────────
PRIMARY_CARRIER=trustmark
TRUSTMARK_MODEL_TYPE=Q          # Q, B, or C variant
TRUSTMARK_PAYLOAD_BITS=100

# ── ZK configuration ──────────────────────────────────────────────────────────
ZK_CIRCUIT_DIR=d:/MediaProvenance/circuits/watermark_commitment
ZK_PTAU_PATH=d:/MediaProvenance/circuits/pot12_final.ptau

# ── Blockchain ────────────────────────────────────────────────────────────────
# Local Hardhat network (default)
ETH_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Contract address populated after deployment
AUDIT_CONTRACT_ADDRESS=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=d:/MediaProvenance/logs/provenancelab.log

# ── DO NOT ADD PRIVATE KEYS, API SECRETS, OR REAL PASSWORDS HERE ─────────────

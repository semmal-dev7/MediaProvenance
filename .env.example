# =================================================================
# ProvenanceLab — Environment Configuration
# =================================================================

# Ethereum Sepolia Testnet RPC URL
# Free public RPCs:
#   - https://ethereum-sepolia-rpc.publicnode.com
#   - https://rpc.sepolia.org
#   - https://sepolia.drpc.org
# Or your Infura / Alchemy Sepolia endpoint:
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Deployer / Submitter Private Key for Sepolia Testnet
# (Use a fresh testnet burner wallet; NEVER put real mainnet private keys here)
SEPOLIA_PRIVATE_KEY=

# Etherscan API Key (Optional, for auto-verifying contract source on sepolia.etherscan.io)
ETHERSCAN_API_KEY=

# Deployed Contract Addresses on Sepolia
PROVENANCE_ANCHOR_ADDRESS=
PROVENANCE_AUDIT_ADDRESS=
